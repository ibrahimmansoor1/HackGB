# Copy to rehome/frontend/.env. The browser calls the backend at this URL.
# Leave unset to go through the Vite dev proxy (vite.config.js): any device on the
# network can then open http://<this laptop's IP>:5173 with no CORS setup.
# Two laptops: http://<backend laptop IP>:8000 (and add this frontend's origin to
# CORS_ORIGINS in rehome/.env).
# PUBLIC_API_URL=http://localhost:8000

# Which backend the Vite proxy forwards /api and /static to (default 127.0.0.1:8000).
# REHOME_BACKEND=http://127.0.0.1:8001
