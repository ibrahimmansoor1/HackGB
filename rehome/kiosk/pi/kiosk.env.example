# Copied to ~/rehome-kiosk/kiosk.env by pi/setup.sh. After editing:
#   systemctl --user restart rehome-kiosk

# The ReHome backend, as the Pi sees it (a laptop on the same hotspot, or the deployed API)
REHOME_BACKEND=http://localhost:8000
# ZIP code donations are filed under
KIOSK_ZIP=54311
# Optional: the public ReHome site; the thank-you screen shows a QR code to it
KIOSK_SITE=
