# Copy to .env (repo root). NEVER commit .env.

# Model provider: "modal" or "gemini"
LLM_PROVIDER=modal
# Text model on Modal: deploy with `modal deploy infra/modal_llm.py`, then paste
# its URL + /v1. Serves the concierge agent (tool calling), requester, pricing,
# and match reasons. Leave the placeholder for offline stub mode.
MODAL_ENDPOINT_URL=https://your-workspace--your-app.modal.run/v1
MODAL_API_KEY=
MODAL_VISION_MODEL=llm
# Tool-calling model for the concierge (defaults to MODAL_VISION_MODEL)
MODAL_AGENT_MODEL=llm
# Optional embedding model on the same endpoint; blank = offline hashed embeddings
MODAL_EMBED_MODEL=
# GLM-5.3 always reasons first: low | high | max (blank = model default, max)
MODAL_REASONING_EFFORT=low

# Input parser (vision) runs on Gemini. Blank = the Modal model reads the photos
# (or the keyword stub parser when Modal isn't configured either).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tiger Data (Postgres) service URL, e.g. postgres://tsdbadmin:<pw>@<host>:<port>/tsdb?sslmode=require
# Leave blank to use the in-memory stub. Create tables once: python scripts/init_db.py
DATABASE_URL=
# Embedding vector size; must match the embedding model (384 = stub embeddings).
# Changing it after init needs: python scripts/init_db.py --reset
EMBED_DIM=384

# Where the backend is reachable; photo URLs are built from it. For a public
# tunnel (so Shopstr can show photos), set it to the tunnel URL.
PUBLIC_BASE_URL=http://localhost:8000
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Marketplace: Nostr classified listings (NIP-99), visible on https://shopstr.store
# Generate a key once: python backend/scripts/nostr_keygen.py
# Live posts need BOTH a key and MARKETPLACE_DRY_RUN=false. Keep the nsec secret.
NOSTR_NSEC=
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
MARKETPLACE_DRY_RUN=true
# Public "location" tag on listings (falls back to the item's zip)
LISTING_LOCATION=Green Bay, WI

# eBay Browse API: active listings as pricing comps (app-only OAuth, no user token).
# Blank = Sell uses the category x condition estimate (basis "estimate").
EBAY_APP_ID=
EBAY_CERT_ID=
# production or sandbox
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_US
# Roadmap: selling on eBay (developer approval pending), Etsy, Shopify
EBAY_DEV_ID=
EBAY_USER_TOKEN=

# Matching
MATCH_THRESHOLD=0.70
TOP_K=3
