# Copy to .env (repo root). NEVER commit .env.

# Model provider: "modal" or "gemini"
LLM_PROVIDER=modal
MODAL_ENDPOINT_URL=https://your-workspace--your-app.modal.run/v1
MODAL_API_KEY=
MODAL_VISION_MODEL=
MODAL_EMBED_MODEL=

# Optional, if Gemini credits come through
GEMINI_API_KEY=

# Database (sponsor). Leave blank to use the in-memory stub.
DATABASE_URL=

# Stretch: eBay sandbox
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_USER_TOKEN=

# Matching
MATCH_THRESHOLD=0.70
TOP_K=3

# Tiger Data (database). Put the service's connection string in DATABASE_URL
# above (Tiger Console -> your service -> Connect), e.g.
#   postgres://tsdbadmin:<password>@<id>.<project>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Size of the embedding vectors (must match MODAL_EMBED_MODEL's output).
EMBED_DIM=384
# DB_BACKEND=memory forces the in-memory stub even when DATABASE_URL is set (tests).
DB_BACKEND=
DB_POOL_MAX=5
